FROM python:3.11-slim

WORKDIR /workspace
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace/src:/workspace

COPY pyproject.toml README.md /workspace/
COPY scripts /workspace/scripts
COPY src /workspace/src
COPY tests /workspace/tests
COPY sample_data /workspace/sample_data
RUN mkdir -p /workspace/data /workspace/output /workspace/output/performance

RUN python -m pip install -U pip \
 && pip install -e ".[dev]" \
 && pip install "jax>=0.4.30" "jaxlib>=0.4.30" "numpyro>=0.15.0" "pymc>=5.0.0" "arviz>=0.17.0"

CMD ["python", "-m", "arena.cli", "--help"]
